{
  "name": "pop-os-super-power",
  "version": "1.0.0-alpha.0",
  "private": true,
  "type": "module",
  "description": "Pop!_OS power profile and GPU mode controls",
  "keywords": [
    "pop-os",
    "power",
    "gpu",
    "mode",
    "controls",
    "super-power",
    "graphics card",
    "battery life",
    "power profiles"
  ],
  "license": "MIT",
  "scripts": {
    "fix": "biome check --write src",
    "lint": "biome check src",
    "format": "biome check --write src",
    "typecheck": "tsc -p tsconfig.json",
    "build:app": "node scripts/copy-uicons.mjs && node scripts/build-app.mjs",
    "install:desktop": "node scripts/install-desktop-entry.mjs",
    "test": "node --test --experimental-strip-types src/**/*.test.ts",
    "prepare": "node scripts/install-git-hooks.mjs",
    "start": "npm run build:app && neu run",
    "build": "npm run build:app && node scripts/keep-linux-only.mjs bin && neu build --clean && node scripts/keep-linux-only.mjs dist",
    "update": "neu update"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.3.0",
    "@neutralinojs/neu": "^11.8.0",
    "@types/node": "^22.15.0",
    "esbuild": "^0.25.4",
    "typescript": "^5.8.3"
  },
  "dependencies": {
    "@flaticon/flaticon-uicons": "^3.3.1"
  }
}
