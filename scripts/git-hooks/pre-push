#!/usr/bin/env bash
# Format, lint, and test before a push. Installed by scripts/install-git-hooks.mjs.
set -euo pipefail

root=$(git rev-parse --show-toplevel)
cd "$root"

if [[ ! -x node_modules/.bin/biome ]]; then
  echo "pre-push: install dependencies first (npm install)"
  exit 1
fi

echo "pre-push: format"
before=$(git diff -- src || true)
npm run format
after=$(git diff -- src || true)
if [[ "$before" != "$after" ]]; then
  echo "pre-push: format changed files under src/. Commit them, then push again."
  git diff --stat -- src
  exit 1
fi

echo "pre-push: lint"
npm run lint

echo "pre-push: test"
npm test
